{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.K11-Software-Solutions/integration-qa",
  "title": "k11 Integration QA",
  "description": "Integration tests across APIs, Kafka messages, batch jobs and databases, as release evidence.",
