  "repository": {
    "url": "https://github.com/K11-Software-Solutions/k11techlab-integration-qa-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "k11-integration-qa-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "QA_MCP_ROOT",
